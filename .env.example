# MongoDB connection. Local (docker compose, see docker-compose.yml):
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
# or MongoDB Atlas: mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster
MONGODB_DB=gymapp
# Long random string used to sign login tokens. CHANGE THIS.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Port the API listens on
PORT=4000
